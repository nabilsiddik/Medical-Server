model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // e.g. INV-2026-0001
  patientId     String
  appointmentId String?
  subtotal      Int           @default(0) // Minor units (e.g., 100000 = 1000.00 BDT)
  discount      Int           @default(0)
  tax           Int           @default(0)
  total         Int           @default(0)
  paidAmount    Int           @default(0)
  dueAmount     Int           @default(0)
  status        PaymentStatus @default(PENDING)
  notes         String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  items         InvoiceItem[]
  payments      Payment[]
  refunds       Refund[]

  @@index([invoiceNumber])
  @@index([patientId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  serviceId   String?
  description String
  unitPrice   Int      // Minor units
  quantity    Int      @default(1)
  total       Int      // Minor units

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}

model Payment {
  id               String         @id @default(uuid())
  invoiceId        String
  amount           Int            // Minor units
  method           PaymentMethod  @default(CASH)
  transactionId    String?        // bKash/Nagad TrxID, Bank ref, Stripe charge ID
  collectedById    String?
  verifiedByDoctor Boolean        @default(true)
  notes            String?
  receiptNumber    String         @unique // e.g. REC-2026-0001

  createdAt        DateTime       @default(now())

  invoice          Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  events           PaymentEvent[]

  @@map("payments")
}

model PaymentEvent {
  id             String   @id @default(uuid())
  paymentId      String?
  gateway        String
  eventType      String
  payload        Json
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("payment_events")
}

model Refund {
  id            String   @id @default(uuid())
  invoiceId     String
  amount        Int      // Minor units
  reason        String
  processedById String?
  createdAt     DateTime @default(now())

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Expense {
  id           String   @id @default(uuid())
  category     String   // RENT, UTILITIES, MEDICAL_SUPPLIES, SALARY, MARKETING, OTHER
  amount       Int      // Minor units
  date         DateTime @db.Date
  description  String?
  recordedById String?
  receiptUrl   String?
  createdAt    DateTime @default(now())

  @@index([date])
  @@map("expenses")
}

model TreatmentPlan {
  id           String        @id @default(uuid())
  patientId    String
  title        String
  totalAmount  Int           // Minor units
  status       String        @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  notes        String?
  createdAt    DateTime      @default(now())

  installments Installment[]

  @@map("treatment_plans")
}

model Installment {
  id                String        @id @default(uuid())
  treatmentPlanId   String
  installmentNumber Int
  dueDate           DateTime      @db.Date
  amount            Int           // Minor units
  paidAmount        Int           @default(0)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?

  treatmentPlan     TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@map("installments")
}

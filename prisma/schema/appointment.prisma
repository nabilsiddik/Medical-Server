model Appointment {
  id                    String                 @id @default(uuid())
  appointmentRef        String                 @unique // e.g. APT-2026-0012
  patientId             String
  doctorId              String?
  chamberLocationId     String
  serviceId             String?
  bookingMode           AppointmentBookingMode @default(SLOT_BASED)
  appointmentDate       DateTime               @db.Date
  startTime             String?                // e.g. "17:15"
  endTime               String?                // e.g. "17:30"
  serialNumber          Int?                   // e.g. 14
  estimatedTime         String?                // e.g. "18:30"
  consultationType      ConsultationType       @default(IN_PERSON)
  status                AppointmentStatus      @default(PENDING)
  bookingSource         BookingSource          @default(WEBSITE)
  isEmergency           Boolean                @default(false)
  priority              Int                    @default(0)
  reasonForVisit        String?                @db.Text
  symptoms              String[]               @default([])
  preVisitIntake        Json?

  // Patient Snapshot for Easy Display
  patientName           String?
  patientPhone          String?
  patientEmail          String?
  whatsappNumber        String?

  // Video Consultation
  videoMeetingLink      String?
  videoProvider         String?                // JITSI, GOOGLE_MEET, ZOOM
  videoSessionId        String?

  // Cancellation & Refund Policy
  cancelReason          String?
  cancelledAt           DateTime?
  cancelledBy           String?                // "DOCTOR" | "PATIENT"
  isRefunded            Boolean                @default(false)
  refundAmount          Int                    @default(0)
  refundReason          String?
  refundedAt            DateTime?

  // Consultation Lifecycle
  checkedInAt           DateTime?
  consultationStartedAt DateTime?
  consultationEndedAt   DateTime?

  // Financial
  fee                   Int                    @default(0)
  isPaid                Boolean                @default(false)
  paymentStatus         PaymentStatus          @default(PENDING)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  patient               Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor                User?                  @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: SetNull)
  chamberLocation       ChamberLocation        @relation(fields: [chamberLocationId], references: [id], onDelete: Cascade)
  service               Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  statusHistory         AppointmentStatusHistory[]
  queueToken            QueueToken?
  visitNote             VisitNote?
  vitals                Vital[]
  invoices              Invoice[]

  @@index([chamberLocationId, appointmentDate, startTime])
  @@index([appointmentDate, status])
  @@index([patientId])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String            @id @default(uuid())
  appointmentId String
  status        AppointmentStatus
  note          String?
  changedById   String?
  createdAt     DateTime          @default(now())

  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_status_history")
}

model QueueToken {
  id                String          @id @default(uuid())
  appointmentId     String          @unique
  chamberLocationId String
  date              DateTime        @db.Date
  tokenNumber       Int
  estimatedCallTime String?
  isCalled          Boolean         @default(false)
  calledAt          DateTime?
  createdAt         DateTime        @default(now())

  appointment       Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([chamberLocationId, date, tokenNumber])
  @@map("queue_tokens")
}

model WaitlistEntry {
  id                String           @id @default(uuid())
  chamberLocationId String
  patientId         String
  preferredDate     DateTime         @db.Date
  consultationType  ConsultationType @default(IN_PERSON)
  isNotified        Boolean          @default(false)
  isClaimed         Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@map("waitlist_entries")
}

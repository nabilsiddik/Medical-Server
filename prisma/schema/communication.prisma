model Notification {
  id           String              @id @default(uuid())
  recipient    String              // Email or Phone number
  channel      NotificationChannel
  title        String
  content      String              @db.Text
  status       NotificationStatus  @default(PENDING)
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  @@index([recipient])
  @@index([status])
  @@map("notifications")
}

model NotificationTemplate {
  id           String              @id @default(uuid())
  code         String              @unique // BOOKING_CONFIRMATION, REMINDER_24H, PRESCRIPTION_READY, etc.
  channel      NotificationChannel
  name         String
  subject      String?
  templateBody String              @db.Text
  variables    String[]            @default([])
  isActive     Boolean             @default(true)
  updatedAt    DateTime            @updatedAt

  @@map("notification_templates")
}

model Campaign {
  id             String              @id @default(uuid())
  title          String
  channel        NotificationChannel
  content        String              @db.Text
  filterCriteria Json?
  totalTarget    Int                 @default(0)
  totalSent      Int                 @default(0)
  status         String              @default("DRAFT") // DRAFT, SCHEDULED, PROCESSING, COMPLETED, CANCELLED
  scheduledAt    DateTime?
  createdAt      DateTime            @default(now())

  @@map("campaigns")
}

model PatientMessage {
  id          String   @id @default(uuid())
  patientId   String
  senderType  String   // PATIENT, DOCTOR
  senderId    String
  content     String   @db.Text
  attachments String[] @default([])
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([patientId])
  @@map("patient_messages")
}

model Conversation {
  id                 String        @id @default(uuid())
  patientId          String?
  patientName        String
  patientPhone       String?
  patientEmail       String?
  lastMessageText    String?       @db.Text
  lastMessageAt      DateTime      @default(now())
  unreadCountDoctor  Int           @default(0)
  unreadCountPatient Int           @default(0)
  aiEnabled          Boolean       @default(true)
  status             String        @default("ACTIVE") // ACTIVE, ARCHIVED

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  patient            Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  messages           ChatMessage[]

  @@index([patientPhone])
  @@index([patientName])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderType     String       // PATIENT, DOCTOR, AI
  senderId       String?
  senderName     String?
  content        String       @db.Text
  isAi           Boolean      @default(false)
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

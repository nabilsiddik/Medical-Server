# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Security
SALT_ROUND=10

# Frontend Client URL
CLIENT_URL=http://localhost:3000

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_minimum_32_characters
JWT_ACCESS_SECRET_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET_EXPIRES_IN=30d
JWT_RESET_PASS_SECRET=your_jwt_password_reset_secret_key_here
JWT_RESET_PASS_SECRET_EXPIRES_IN=10m

# Email Service (Nodemailer / Gmail App Password)
EMAIL_SENDER_EMAIL=your-email@gmail.com
EMAIL_SENDER_APP_PASS=your-app-password
ADMIN_EMAIL=nabilsiddik70@gmail.com

# Cloudinary (Optional Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# DigitalOcean Spaces / S3 (Optional)
DO_SPACE_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACE_ACCESS_KEY=your_access_key
DO_SPACE_SECRET_KEY=your_secret_key
DO_SPACE_BUCKET=your_bucket_name

# Social OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/v1/auth/facebook/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/v1/auth/github/callback

# Stripe (Optional)
STRIPE_SECRET_KEY=sk_test_...
